# Host-side service for the ROS2 stack inside the ros2_humble container.
# Starts at boot, restarts the stack if a core process crashes (via
# amr-stack-supervisor.sh), and does NOT restart it after a manual stop.
#
# Install on the i.MX8M Plus host (as root):
#   sudo cp /root/ros2_ws/src/ros-amr/docker/amr-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now amr-stack
#
# Day to day:
#   sudo systemctl stop amr-stack      # stop (no auto-restart)
#   sudo systemctl start amr-stack     # start again
#   systemctl status amr-stack         # state
#   journalctl -u amr-stack -f         # supervisor log
# Per-process logs are in the container at /tmp/<name>_stack.log.

[Unit]
Description=AMR ROS2 full stack supervisor (in ros2_humble container)
After=docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/root/ros2_ws/src/ros-amr/docker/amr-stack-supervisor.sh
# Only the supervisor gets the stop signal, so it can run its own clean stop.
KillMode=process
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
